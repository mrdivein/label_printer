{
  "width_mm": 50,
  "height_mm": 30,
  "dpi": 300,
  "orientation": "portrait",
  "copies": 1,
  "offset_x_mm": 0,
  "offset_y_mm": 0,
  "threshold": 180,
  "data_bindings": {"Name": "Name", "Code": "Code", "Price": "Price", "Barcode": "Barcode"},
  "elements": [
    {"type": "text", "text": "{{Name}}", "x": 2, "y": 1.5, "w": 46, "h": 4.5, "font": "Arial", "font_size": 10, "bold": true, "align": "left", "wrap": false, "auto_fit": true, "min_font_size": 7},
    {"type": "text", "text": "{{Code}}", "x": 2, "y": 6.5, "w": 28, "h": 3, "font": "Arial", "font_size": 6.5, "align": "left", "wrap": false},
    {"type": "text", "text": "{{Price}}", "x": 30, "y": 6.5, "w": 18, "h": 3, "font": "Arial", "font_size": 6.5, "bold": true, "align": "right", "wrap": false, "auto_fit": true, "min_font_size": 5},
    {"type": "line", "x": 2, "y": 10.2, "x2": 48, "y2": 10.2, "thickness": 0.15},
    {"type": "barcode", "value": "{{Barcode}}", "x": 5, "y": 12, "w": 40, "h": 11, "symbology": "code128", "barcode_height_mm": 10, "module_width": 0.3, "quiet_zone": 1, "show_text": false},
    {"type": "text", "text": "{{Barcode}}", "x": 2, "y": 24, "w": 46, "h": 3, "font": "Arial", "font_size": 6, "align": "center", "wrap": false}
  ]
}
